# ATG Local Development Environment for Docker Compose

# Compose image version
VERSION=demo-1.8.0

# Docker Registry
DOCKER_REGISTRY=toppan-crvs

# Country config
COUNTRY=ATG
LANGUAGES=en

# Service environment
NODE_ENV=development
DOMAIN=localhost
HOSTNAME=localhost

# Internal service discovery (used inside Docker network)
GATEWAY_URL=http://gateway:7070
GATEWAY_URL_INTERNAL=http://gateway:7070
AUTH_URL=http://auth:4040
AUTH_URL_INTERNAL=http://auth:4040
FHIR_URL=http://hearth:3447/fhir
COUNTRY_CONFIG_HOST=http://countryconfig:3040
COUNTRY_CONFIG_URL_INTERNAL=http://countryconfig:3040
APPLICATION_CONFIG_URL=http://config:2021
ES_URL=http://elasticsearch:19200

# Frontend URLs (used by browser)
PUBLIC_GATEWAY_URL=http://localhost:7070
PUBLIC_CONFIG_URL=http://localhost:2021
PUBLIC_COUNTRY_CONFIG_URL=http://localhost:3040
PUBLIC_AUTH_URL=http://localhost:4040
PUBLIC_LOGIN_URL=http://localhost:3020
PUBLIC_CLIENT_APP_URL=http://localhost:3000

# Service URLs for countryconfig
CLIENT_APP_URL=http://localhost:3000
COUNTRY_CONFIG_URL=http://localhost:3040
LOGIN_URL=http://localhost:3020
CONFIRM_REGISTRATION_URL=http://localhost:3020

# Content Security Policy
CONTENT_SECURITY_POLICY_WILDCARD=localhost

# Certificate paths
CERT_PRIVATE_KEY_PATH=/secrets/private-key.pem
CERT_PUBLIC_KEY_PATH=/secrets/public-key.pem

# Optional - Sentry (leave blank for local dev)
SENTRY=

# Node TLS
NODE_TLS_REJECT_UNAUTHORIZED=0
