# ATG-specific Local Development Overrides
# Copy of .env tuned for the Antigua & Barbuda configuration.

NODE_ENV=development
DOMAIN=localhost
HOSTNAME=localhost

# Service URLs exposed on the host machine
GATEWAY_URL=http://localhost:7070
GATEWAY_URL_INTERNAL=http://localhost:7070
AUTH_URL=http://localhost:4040
AUTH_URL_INTERNAL=http://localhost:4040
FHIR_URL=http://localhost:3447/fhir
COUNTRY_CONFIG_HOST=http://localhost:3040
COUNTRY_CONFIG_URL_INTERNAL=http://localhost:3040
APPLICATION_CONFIG_URL=http://localhost:2021

# Frontend URLs (browser-facing)
PUBLIC_GATEWAY_URL=http://localhost:7070
PUBLIC_CONFIG_URL=http://localhost:2021
PUBLIC_COUNTRY_CONFIG_URL=http://localhost:3040
PUBLIC_AUTH_URL=http://localhost:4040
PUBLIC_LOGIN_URL=http://localhost:3020
PUBLIC_CLIENT_APP_URL=http://localhost:3000

# Country config
COUNTRY=ATG
LANGUAGES=en

# Additional service URLs for country config
CLIENT_APP_URL=http://localhost:3000
COUNTRY_CONFIG_URL=http://localhost:3040
LOGIN_URL=http://localhost:3020
CONFIRM_REGISTRATION_URL=http://localhost:3020

# Certificates
CERT_PRIVATE_KEY_PATH=../../.secrets/private-key.pem
CERT_PUBLIC_KEY_PATH=../../.secrets/public-key.pem

# Optional Sentry placeholder
SENTRY=

# Local TLS override for development
NODE_TLS_REJECT_UNAUTHORIZED=0
