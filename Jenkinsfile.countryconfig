pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        retry(2)
        skipStagesAfterUnstable()
    }

    environment {
        // Git-based versioning
        VERSION = ""
        REGISTRY = "${env.DOCKER_REGISTRY ?: '695491315778.dkr.ecr.us-east-1.amazonaws.com/toppan-crvs'}"
        BRANCH = "${env.GIT_BRANCH ?: 'develop'}"

        // Docker Configuration
        DOCKER_BUILDKIT = '1'
        COMPOSE_DOCKER_CLI_BUILD = '1'

        // CountryConfig specific
        SERVICE_NAME = "countryconfig"
        COUNTRYCONFIG_REPO = "https://git-codecommit.ap-east-1.amazonaws.com/v1/repos/opencrvs_countryconfig"

        // Credentials
        AWS_ECR_CREDENTIALS = credentials('aws-ecr-credentials')
        AWS_CODECOMMIT_CREDENTIALS = credentials('aws-codecommit-credentials')
    }

    parameters {
        choice(
            name: 'BUILD_STRATEGY',
            choices: ['auto', 'force-rebuild'],
            description: 'Auto: Only build if changes detected | Force: Always build'
        )
        booleanParam(
            name: 'PUSH_TO_REGISTRY',
            defaultValue: true,
            description: 'Push built images to AWS ECR (695491315778.dkr.ecr.us-east-1.amazonaws.com/toppan-crvs)'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Show what would be built without actually building'
        )
        string(
            name: 'CUSTOM_VERSION',
            defaultValue: '',
            description: 'Custom version tag (leave empty for auto-generated git hash)'
        )
    }

    stages {
        stage('🔧 Initialize & Setup') {
            steps {
                script {
                    // Set version from git hash or custom parameter
                    if (params.CUSTOM_VERSION) {
                        env.VERSION = params.CUSTOM_VERSION
                    } else {
                        env.VERSION = sh(
                            script: 'git log -1 --pretty=format:%h',
                            returnStdout: true
                        ).trim()
                    }

                    echo "🏗️  CountryConfig Build Pipeline"
                    echo "=================================================="
                    echo "  Version: ${env.VERSION}"
                    echo "  Registry: ${env.REGISTRY}"
                    echo "  Branch: ${env.BRANCH}"
                    echo "  Build Strategy: ${params.BUILD_STRATEGY}"
                    echo "  Push to Registry: ${params.PUSH_TO_REGISTRY}"
                    echo "  Dry Run: ${params.DRY_RUN}"
                    echo "=================================================="
                }
            }
        }

        stage('📥 Clone CountryConfig Repository') {
            steps {
                script {
                    echo "📥 Cloning countryconfig repository..."

                    // Clean up any existing countryconfig directory
                    sh 'rm -rf opencrvs-countryconfig'

                    // Clone the countryconfig repository
                    withCredentials([sshUserPrivateKey(credentialsId: 'aws-codecommit-ssh', keyFileVariable: 'SSH_KEY')]) {
                        sh '''
                            eval $(ssh-agent -s)
                            ssh-add $SSH_KEY
                            git clone $COUNTRYCONFIG_REPO opencrvs-countryconfig
                            cd opencrvs-countryconfig
                            git checkout $BRANCH || git checkout develop || git checkout main
                            echo "Current commit: $(git log -1 --pretty=format:'%h - %s')"
                        '''
                    }
                }
            }
        }

        stage('🔍 Change Detection') {
            when {
                expression { params.BUILD_STRATEGY == 'auto' }
            }
            steps {
                script {
                    echo "🔍 Detecting changes in countryconfig..."

                    def hasChanges = sh(
                        script: '''
                            cd opencrvs-countryconfig
                            # Check if this is the first build or if there are recent changes
                            if [ ! -f "../.last_countryconfig_build" ]; then
                                echo "First build detected"
                                exit 0
                            fi

                            LAST_BUILD=$(cat ../.last_countryconfig_build)
                            CURRENT_COMMIT=$(git log -1 --pretty=format:%h)

                            if [ "$LAST_BUILD" != "$CURRENT_COMMIT" ]; then
                                echo "Changes detected: $LAST_BUILD -> $CURRENT_COMMIT"
                                exit 0
                            else
                                echo "No changes detected"
                                exit 1
                            fi
                        ''',
                        returnStatus: true
                    )

                    if (hasChanges == 0) {
                        env.SHOULD_BUILD = "true"
                        echo "✅ Changes detected - proceeding with build"
                    } else {
                        env.SHOULD_BUILD = "false"
                        echo "⏭️  No changes detected - skipping build"
                    }
                }
            }
        }

        stage('🏗️  Build CountryConfig') {
            when {
                anyOf {
                    expression { params.BUILD_STRATEGY == 'force-rebuild' }
                    expression { env.SHOULD_BUILD == 'true' }
                    expression { params.DRY_RUN == true }
                }
            }
            steps {
                script {
                    if (params.DRY_RUN) {
                        echo "🧪 DRY RUN: Would build countryconfig:${env.VERSION}"
                        return
                    }

                    echo "🏗️  Building countryconfig service..."

                    sh '''
                        cd opencrvs-countryconfig

                        # Build the countryconfig Docker image
                        echo "Building countryconfig Docker image..."
                        docker build -t ${REGISTRY}/countryconfig:${VERSION} .

                        # Tag as latest
                        docker tag ${REGISTRY}/countryconfig:${VERSION} ${REGISTRY}/countryconfig:latest

                        echo "✅ CountryConfig build completed"
                    '''
                }
            }
        }

        stage('📦 Push to Registry') {
            when {
                allOf {
                    expression { params.PUSH_TO_REGISTRY == true }
                    expression { params.DRY_RUN == false }
                    anyOf {
                        expression { params.BUILD_STRATEGY == 'force-rebuild' }
                        expression { env.SHOULD_BUILD == 'true' }
                    }
                }
            }
            steps {
                script {
                    echo "📦 Pushing countryconfig to ECR..."

                    withCredentials([aws(credentialsId: 'aws-ecr-credentials', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        sh '''
                            # ECR authentication for us-east-1
                            aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 695491315778.dkr.ecr.us-east-1.amazonaws.com

                            # Push versioned image
                            echo "Pushing ${REGISTRY}/countryconfig:${VERSION}"
                            docker push ${REGISTRY}/countryconfig:${VERSION}

                            # Push latest tag
                            echo "Pushing ${REGISTRY}/countryconfig:latest"
                            docker push ${REGISTRY}/countryconfig:latest

                            echo "✅ CountryConfig images pushed successfully"
                        '''
                    }
                }
            }
        }

        stage('📝 Update Build Record') {
            when {
                allOf {
                    expression { params.DRY_RUN == false }
                    anyOf {
                        expression { params.BUILD_STRATEGY == 'force-rebuild' }
                        expression { env.SHOULD_BUILD == 'true' }
                    }
                }
            }
            steps {
                script {
                    sh '''
                        cd opencrvs-countryconfig
                        CURRENT_COMMIT=$(git log -1 --pretty=format:%h)
                        echo $CURRENT_COMMIT > ../.last_countryconfig_build
                        echo "📝 Updated build record: $CURRENT_COMMIT"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo "🧹 Cleaning up..."
                sh '''
                    # Clean up Docker images to save space
                    docker system prune -f || true

                    # Clean up countryconfig directory
                    rm -rf opencrvs-countryconfig || true
                '''
            }
        }
        success {
            script {
                if (params.DRY_RUN) {
                    echo "✅ DRY RUN: CountryConfig pipeline completed successfully"
                } else {
                    echo "✅ CountryConfig pipeline completed successfully"
                    echo "📋 Summary:"
                    echo "  Service: countryconfig"
                    echo "  Version: ${env.VERSION}"
                    echo "  Registry: ${env.REGISTRY}/countryconfig:${env.VERSION}"
                    if (params.PUSH_TO_REGISTRY) {
                        echo "  Status: Built and pushed to ECR"
                    } else {
                        echo "  Status: Built locally (not pushed)"
                    }
                }
            }
        }
        failure {
            script {
                echo "❌ CountryConfig pipeline failed"
                echo "Check the logs above for error details"
            }
        }
    }
}