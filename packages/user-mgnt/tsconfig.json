{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@user-mgnt/*": ["./*"]
    },
    "target": "es6",
    "module": "node16",
    "rootDir": ".",
    "sourceMap": true,
    "moduleResolution": "node16",
    "outDir": "build/dist",
    "lib": ["esnext.asynciterable", "es6", "es2017", "dom"],
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["fhir", "jest"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "typings"],
  "exclude": [
    "node_modules",
    "build",
    "scripts",
    "acceptance-tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
