{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CertificateService.Core.Services.PdfSigningService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "CertificateService": {
    // === Template Configuration ===
    "TemplatesPath": "/app/templates",
    "DefaultLayoutFileName": "ElmLayout.txt",

    // Template definitions for multi-page certificates
    // NOTE: Background images are referenced in ElmLayout.txt, not directly here
    // Only Birth certificate is enabled - Death and Marriage templates not ready yet
    "Templates": {
      "Birth": {
        "FolderName": "Birth",
        "LayoutFile": "ElmLayout.txt",
        "FrontPageBackgroundImage": "SampleBirthCertificate.png",
        "BackPageBackgroundImage": "SampleBirthCertificateBack.png",
        "SupportedPages": ["front", "back"],
        "RequireSections": ["child"],
        "FrontAmendmentCount": 5,
        "BackAmendmentMaxRows": 24,
        "BackAmendmentMaxCols": 2
      }
    },

    // === Performance ===
    "MaxConcurrentRenders": 5,
    "RenderTimeoutSeconds": 30,
    "EnableCaching": true,
    "CacheDurationMinutes": 60,

    // === PDF Generation ===
    "PdfSettings": {
      "DefaultDpi": 300,
      "PageWidth": 1325,
      "PageHeight": 1732,
      "CompressionEnabled": true,
      "PdfVersion": "1.7",
      "EmbedFonts": true
    },

    // === Multi-Page Configuration ===
    "PageSettings": {
      "FrontPageSections": ["certificate", "data"],
      "BackPageSections": ["amendments", "notes"],
      "MaxAmendmentsPerPage": 5,
      "EnableDynamicPageCount": true
    },

    // === Output ===
    "OutputPath": "/app/test-output",

    // Debug Mode: When true, saves files to OutputPath. When false, returns base64 only.
    // Set to false in production to avoid filling up disk space
    "DebugMode": false,
    "RetainGeneratedFiles": true,
    "MaxOutputFileSizeMB": 10,

    // Output format configuration
    // Formats: "PDF", "PDFA" (PDF/A-1b for archival), "JPG", "PNG"
    // Use case: PDF/PDFA for printing, JPG for web viewing
    "OutputFormats": {
      "Enabled": ["PDFA", "JPG"],
      "Printing": {
        "Format": "PDFA",
        "Dpi": 300,
        "Quality": 95
      },
      "Viewing": {
        "Format": "JPG",
        "Dpi": 150,
        "Quality": 90
      },
      "Archival": {
        "Format": "PDFA",
        "Dpi": 300,
        "Enabled": false
      }
    },

    // === Fonts ===
    "FontsPath": "/app/templates/fonts",
    "FallbackFont": "arial.ttf",

    // === Signature ===
    "SignatureFilePath": "/app/templates/Birth/signature.png",
    "PdfSigningKeyPath": "/app/keys/certificate-private-key.pem",
    "PdfVerificationKeyPath": "/app/keys/certificate-public-key.pem",

    // === Validation ===
    "MaxAmendments": 50,
    "MaxRequestSizeMB": 5,
    "RequiredFields": ["certificateType", "templateName"],

    // === Health Check ===
    "HealthCheck": {
      "ValidateTemplatesOnStartup": true,
      "TemplateWatcherEnabled": false,
      "RequiredTemplates": ["Birth"]
    },

    // === Logging & Debugging ===
    "EnableDetailedLogging": true,
    "LogRenderTimings": true,
    "LogAmendmentProcessing": true
  }
}
