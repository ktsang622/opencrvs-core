{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "CertificateService": "Debug"
    }
  },
  "CertificateService": {
    "TemplatesPath": "/app/templates",
    "OutputPath": "./test-output",

    // Enable debug mode in development to save files to disk
    "DebugMode": true,
    "RetainGeneratedFiles": true,
    "EnableDetailedLogging": true,
    "LogRenderTimings": true,
    "LogAmendmentProcessing": true,

    // More relaxed timeouts for debugging
    "RenderTimeoutSeconds": 120,

    // Disable caching for easier development
    "EnableCaching": false,

    // Health check - don't fail fast during development
    "HealthCheck": {
      "ValidateTemplatesOnStartup": false,
      "TemplateWatcherEnabled": true
    }
  }
}
